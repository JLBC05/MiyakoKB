# --- 本地临时脚本与凭据/数据产物（禁止入库：可能含真实密钥、内网地址或数据库备份） ---
# 例：tmp_switch_vlm_deepseek.py 含真实 API Key；temp/backup-before-cleanup/saber.sqlite3 含整份凭据库
/tmp_*
/_tmp_*
/tmp-*
/dump_*
/_dump*
/temp/
*.sqlite3
*.sqlite3-*
*.db
*.db-*

# README 图片与架构图（docs/* 默认忽略，这里显式放行）
!docs/assets/
!docs/assets/**

# vite build 用的临时目录（$env:TEMP 重定向目标）
vue-frontend/.vite-tmp/

# Archify 生成过程目录（架构图源文件与截图，不入库）
.archify/

